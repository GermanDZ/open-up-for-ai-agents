{
  "defaultMode": "acceptEdits",
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Read"
    ]
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR\"/.claude/scripts/hooks/stage-run-log.py ]; then python3 \"$CLAUDE_PROJECT_DIR\"/.claude/scripts/hooks/stage-run-log.py; fi"
          },
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR\"/.claude/scripts/hooks/check-iteration.py ]; then python3 \"$CLAUDE_PROJECT_DIR\"/.claude/scripts/hooks/check-iteration.py; fi"
          },
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR\"/.claude/scripts/hooks/validate-commit.py ]; then python3 \"$CLAUDE_PROJECT_DIR\"/.claude/scripts/hooks/validate-commit.py; fi"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR\"/.claude/scripts/hooks/gate-edits.py ]; then python3 \"$CLAUDE_PROJECT_DIR\"/.claude/scripts/hooks/gate-edits.py; fi"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR\"/.claude/scripts/hooks/on-branch-created.py ]; then python3 \"$CLAUDE_PROJECT_DIR\"/.claude/scripts/hooks/on-branch-created.py; fi"
          },
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR\"/.claude/scripts/hooks/auto-log-commit.py ]; then python3 \"$CLAUDE_PROJECT_DIR\"/.claude/scripts/hooks/auto-log-commit.py; fi"
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR\"/.claude/scripts/hooks/on-plan-exit.py ]; then python3 \"$CLAUDE_PROJECT_DIR\"/.claude/scripts/hooks/on-plan-exit.py; fi"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR\"/.claude/scripts/hooks/on-stop.py ]; then python3 \"$CLAUDE_PROJECT_DIR\"/.claude/scripts/hooks/on-stop.py; fi"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR\"/.claude/scripts/hooks/on-task-request.py ]; then python3 \"$CLAUDE_PROJECT_DIR\"/.claude/scripts/hooks/on-task-request.py; fi"
          },
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR\"/.claude/scripts/hooks/check-unfinished-tasks.py ]; then python3 \"$CLAUDE_PROJECT_DIR\"/.claude/scripts/hooks/check-unfinished-tasks.py; fi"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR\"/scripts/session-start.sh ]; then bash \"$CLAUDE_PROJECT_DIR\"/scripts/session-start.sh; fi"
          }
        ]
      }
    ]
  }
}
